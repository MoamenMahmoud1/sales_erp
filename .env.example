# Mobile build configuration
# Copy to .env before using tool/build_release_from_env.sh.
# Flutter itself does not automatically load .env files; the helper script
# reads this file and passes API_BASE_URL as a Dart compile-time define.
API_BASE_URL=https://api.example.com/api/v1

# Firebase client identifiers. These are not server secrets.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
